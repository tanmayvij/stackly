rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Content-addressed file blobs, scoped per user: {uid}/{projectId}/{sha256}.
    // Blobs are immutable (name = content hash), so writes only ever create.
    match /{uid}/{projectId}/{blob} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
