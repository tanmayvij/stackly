# Copy this file to `.secret.local` (gitignored) and fill in real values.
# The Firebase emulator loads these secrets for local runs. For deployed
# functions, set each one instead with:
#   firebase functions:secrets:set STRIPE_SECRET_KEY

# Stripe secret (API) key — use a test key (sk_test_...) locally.
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
