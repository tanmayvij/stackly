# Copy this file to `.secret.local` (gitignored) and fill in real values.
# The Firebase emulator loads these secrets for local runs. For deployed
# functions, set each one instead with:
#   firebase functions:secrets:set STRIPE_SECRET_KEY

# Stripe secret (API) key — use a test key (sk_test_...) locally.
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key

# HighLevel (GHL) OAuth app credentials from the GHL Marketplace app.
GHL_CLIENT_ID=your_ghl_client_id
GHL_CLIENT_SECRET=your_ghl_client_secret
# OAuth redirect URI — must exactly match the frontend VITE_GHL_REDIRECT_URI
# and the redirect registered on the GHL Marketplace app.
GHL_REDIRECT_URI=https://your-app/leadconnector/oauth

# OpenAI-compatible LLM endpoint used to name new projects and to power
# the builder chat.
OPENAI_API_KEY=your_llm_api_key
OPENAI_BASE_URL=https://your-llm-gateway/v1

# HMAC key (32+ random bytes) that signs short-lived preview tokens for
# generated apps. Generate with e.g.: openssl rand -hex 32
PREVIEW_TOKEN_SECRET=your_random_preview_token_secret
